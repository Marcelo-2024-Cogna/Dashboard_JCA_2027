<?php
/**
 * deploy/config/secrets.local.php.production.example — MODELO PARA PRODUCAO (SEM segredos)
 * ──────────────────────────────────────────────────────────────────────────
 * Copiar NO SERVIDOR para /apps/metricas_jca/config/secrets.local.php e preencher.
 * O arquivo real nunca vai para o git (config/secrets.local.php esta no .gitignore).
 *
 *   sudo cp deploy/config/secrets.local.php.production.example config/secrets.local.php
 *   sudo chown root:www-data config/secrets.local.php ; sudo chmod 640 config/secrets.local.php
 *
 * Este arquivo e lido por config/jira.php tanto na WEB quanto no CLI (worker
 * do cron), e so preenche variaveis que NAO estejam ja definidas no ambiente.
 *
 * Token do Jira: token CLASSICO (sem escopo) da conta de servico/analista.
 * Tokens com escopo (OAuth) NAO funcionam com Basic auth.
 *
 * SSL: NAO defina JIRA_SSL_VERIFY=0 em producao. A verificacao do certificado
 * fica ATIVA por padrao; se a saida do servidor para o Jira passa por proxy
 * corporativo (certificado proprio), aponte JIRA_CA_BUNDLE para o .pem da CA.
 * ATENCAO: JIRA_CA_BUNDLE SUBSTITUI o bundle do sistema (CURLOPT_CAINFO). O
 * arquivo precisa conter TODAS as CAs necessarias: gere-o assim, por exemplo:
 *   cat /etc/ssl/certs/ca-certificates.crt CA_CORPORATIVA.pem > /apps/metricas_jca/config/ca-bundle.pem
 * (alternativa: instalar a CA corporativa no sistema com update-ca-certificates
 * e deixar JIRA_CA_BUNDLE vazio/ausente.)
 */

return [
    'JIRA_EMAIL'     => 'EMAIL_DA_CONTA_JIRA',
    'JIRA_API_TOKEN' => 'COLE_AQUI_O_TOKEN_CLASSICO_DO_JIRA',
    'JIRA_CA_BUNDLE' => '/apps/metricas_jca/config/ca-bundle.pem',

    // Opcional (padrao em config/jira.php: https://cogna.atlassian.net):
    // 'JIRA_HOST' => 'https://cogna.atlassian.net',
];
