# Credenciais de conexão ao banco (específicas de cada ambiente).
# O modelo versionável é config/db.php.example.
config/db.php

# Logs de execução (mantém apenas o diretório versionado).
data/logs/*.log
data/logs/*.log.*

# Artefatos de execução da fila de extração (a fonte de verdade é a tabela
# extracao_agendamento) e log do notificador em modo stub.
data/agendamentos/ordem_*.json
data/notificacoes.log
# Artefatos de trabalho dos workflows (task.md, design, reviews, plan).
# São rascunhos de processo, não fazem parte do produto versionado.
.agents/
# Configuração local de MCP (contém token do Jira específico do ambiente).
# Mantido apenas localmente; não versionar segredos.
.kiro/settings/mcp.json
